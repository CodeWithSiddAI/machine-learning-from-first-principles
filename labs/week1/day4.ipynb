    "import numpy as np\n",
    "\n",
    "def f(x):\n",
    "    return x**2\n",
    "\n",
    "def numeriacal_derivative(f, x, h=1e-5):\n",
    "    return (f(x+h) - f(x)) / h \n",
    "\n",
    "print(numeriacal_derivative(f, 3))"
   ]
